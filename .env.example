# ======================
# Database (TimescaleDB)
# ======================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradingbot
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradingbot

# ======================
# Web Control Panel (Phase 6)
# ======================
# New app DB (separate from OHLCV `tradingbot` DB). Must CREATE DATABASE first:
#   psql -U postgres -c "CREATE DATABASE tradingbot_app;"
# Role separation (tradingbot_app_user with limited grants) deferred to Phase 6 slice 9.
APP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradingbot_app

# Session cookie signing key. Generate fresh per environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change_me_generate_with_secrets_token_hex_32

# ======================
# Redis
# ======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ======================
# Binance API
# ======================
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# ======================
# Bybit API
# ======================
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# ======================
# Telegram (Phase 4/5)
# ======================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ======================
# App Settings
# ======================
LOG_LEVEL=INFO
ENVIRONMENT=development

# ======================
# CoinMarketCap API
# ======================
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
