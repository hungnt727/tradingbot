# TradingBot production .env (Phase 6) — copy to .env on the VPS and fill in.
# Consumed by BOTH tradingbot-web and tradingbot-worker.

# --- OHLCV DB (existing `tradingbot`) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradingbot

# --- App DB (`tradingbot_app`) — use the dedicated limited role, NOT postgres ---
APP_DATABASE_URL=postgresql://tradingbot_app_user:CHANGE_ME@localhost:5432/tradingbot_app

# --- Redis (sessions + CMC cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Session cookie signing key — generate fresh, never reuse ---
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX

# --- Shared Telegram bot (one bot for the whole team, via BotFather) ---
TELEGRAM_BOT_TOKEN=CHANGE_ME

# --- Shared CoinMarketCap API key (Top-N resolver, cached 1h) ---
COINMARKETCAP_API_KEY=CHANGE_ME

# --- Worker loop cadence (seconds). 10 keeps "Quét ngay" responsive. ---
WORKER_SLEEP_SECONDS=10
